<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YmmTextAlign</AssemblyName>
    <Version>0.3.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Plugin"><HintPath>$(YMM4Dir)\YukkuriMovieMaker.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker"><HintPath>$(YMM4Dir)\YukkuriMovieMaker.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Vortice.Direct2D1"><HintPath>$(YMM4Dir)\Vortice.Direct2D1.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.DirectX"><HintPath>$(YMM4Dir)\Vortice.DirectX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>$(YMM4Dir)\Vortice.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpGen.Runtime"><HintPath>$(YMM4Dir)\SharpGen.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireYmmReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(YMM4Dir)\YukkuriMovieMaker.dll')" Text="YMM4Dir に YMM4 4.53.0.1 のフォルダーを指定してください。" />
  </Target>
</Project>
